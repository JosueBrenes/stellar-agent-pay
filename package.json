{
  "name": "stellar-agent-pay",
  "version": "0.1.0",
  "description": "Stellar CLI plugin that lets AI agents unlock x402 paid HTTP resources with USDC under an auditable spending policy",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky || true",
    "demo:mock": "node examples/mock-seller/server.js",
    "demo:seller": "node examples/seller/server.js",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml}\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "stellar-cli-plugin",
    "x402",
    "soroban",
    "usdc",
    "agent",
    "ai-agent",
    "payments",
    "http-402",
    "micropayments",
    "cli",
    "agentic-payments"
  ],
  "author": "Josue Brenes",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "@x402/core": "^2.20.0",
    "@x402/fetch": "^2.20.0",
    "@x402/stellar": "^2.20.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@x402/express": "^2.20.0",
    "eslint": "^10.8.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "bin": {
    "stellar-agent-pay": "./dist/cli.js"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "homepage": "https://github.com/JosueBrenes/stellar-agent-pay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosueBrenes/stellar-agent-pay.git"
  },
  "bugs": {
    "url": "https://github.com/JosueBrenes/stellar-agent-pay/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/cli.js"
}

# Copy to .env and fill in. Never commit the real file.

# ---- buyer: the agent that pays ----------------------------------------------
# Payer secret key. Takes precedence over ~/.stellar-agent-pay/wallet.json,
# so an agent can run without writing a key to disk.
STELLAR_SECRET_KEY=

# CAIP-2 network id. stellar:testnet (default) or stellar:pubnet.
STELLAR_NETWORK=stellar:testnet

# Optional: move the config, policy and audit directory.
# STELLAR_AGENT_PAY_HOME=

# ---- seller: examples/seller only --------------------------------------------
# G... account that receives the USDC. Needs a USDC trustline.
STELLAR_RECIPIENT=

# OpenZeppelin Channels API key, required on testnet and mainnet.
# testnet: https://channels.openzeppelin.com/testnet/gen
# mainnet: https://channels.openzeppelin.com/gen
OZ_API_KEY=

# Facilitator endpoint. Defaults to the testnet one.
# FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# SELLER_PORT=3001
